  m_Script: {fileID: 11500000, guid: 7c3f9a12b4d84e7fa9c05d6e18b32f40, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDirector
  typewriter: {fileID: 0}
  dialogueRoot: {fileID: 0}
  dialoguePrefab: {fileID: 830250050840247125, guid: 90a2dc1c8bd99f549ba1bb5e1afbba7c, type: 3}
  tutorialFloorIndex: 0
  runOnce: 1
  startDelay: 0.5
  lockClockUntilTaught: 1
  moveHoldRequired: 0.5
  conditionTimeout: 0
  delayBeforeNextBeat: 1
  repeatAfterSeconds: 10
  pauseGameWhileSpeaking: 1
  allowSkipInput: 1
  requireDismissInput: 1
  skipLockout: 0.2
  beats:
  - line: Welcome to the clock tower. Move with WASD.
    condition: 1
    holdWorldWhileReading: 1
    minReadTime: 0.4
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: Space dodges. You will need it.
    condition: 2
    holdWorldWhileReading: 1
    minReadTime: 0.4
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: Left click to attack.
    condition: 3
    holdWorldWhileReading: 1
    minReadTime: 0.4
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: Press 1, 2 or 3 to swap weapons.
    condition: 5
    holdWorldWhileReading: 1
    minReadTime: 0.4
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: Now clear them out.
    condition: 7
    holdWorldWhileReading: 1
    minReadTime: 0.4
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: That clock is your life. When it runs out, so do you.
    condition: 0
    holdWorldWhileReading: 1
    minReadTime: 0.6
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: Strike a hand against its sweep and it pays you back in time.
    condition: 6
    holdWorldWhileReading: 1
    minReadTime: 0.6
    releaseFloorGate: 0
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
  - line: But the tower learns. Every strike after the first is worth far less, until
      the next floor.
    condition: 0
    holdWorldWhileReading: 1
    minReadTime: 0.6
    releaseFloorGate: 1
    unlockClockStrikes: 0
    repeatIfIdle: 1
    skipIfAlreadyMet: 1
    skipIf: 0
